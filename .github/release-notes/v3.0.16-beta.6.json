{
  "changes": [
    {
      "id": "tablet",
      "category": "highlights",
      "summary": "恢复 Android 平板横屏的桌面式布局，统一侧栏、浏览区、封面、歌词和播放控制的排布，并恢复桌面式收起播放器的操作。"
    },
    {
      "id": "overlay-sync",
      "category": "highlights",
      "summary": "改进桌面歌词与原生播放进度、暂停和恢复状态的同步，减少后台歌词更新延迟。"
    },
    {
      "id": "overlay-restore",
      "category": "fixes",
      "summary": "重新打开应用或返回前台时恢复已开启的桌面歌词，并根据悬浮窗口的实际状态更新开关。"
    },
    {
      "id": "overlay-error",
      "category": "fixes",
      "summary": "悬浮歌词窗口未能显示或关闭失败时给出明确提示，避免错误显示为已开启或已关闭。"
    },
    {
      "id": "mobile",
      "category": "fixes",
      "summary": "修复手机及较窄平板的专辑、歌手和歌手专辑页在长文本、大字号、分页标签及滚动场景下的头部对齐问题。"
    },
    {
      "id": "controls",
      "category": "fixes",
      "summary": "改进播放控件的触摸操作区域、键盘操作和无障碍标签。"
    },
    {
      "id": "playback",
      "category": "fixes",
      "summary": "修复快速切歌、切换音质或音源期间旧请求覆盖当前歌曲的问题；保留最新的暂停状态和播放进度，并避免延迟重试意外恢复播放。"
    },
    {
      "id": "lyrics",
      "category": "fixes",
      "summary": "修复逐字时间、翻译或罗马音变化未及时刷新，以及旧歌曲歌词覆盖当前歌曲的问题；正确应用 LRC 文件中的时间偏移。"
    },
    {
      "id": "download",
      "category": "fixes",
      "summary": "改进下载暂停、继续、取消、并发和进度恢复，处理断点续传异常，并加强下载文件及已有用户文件的保护。"
    },
    {
      "id": "download-lyrics",
      "category": "fixes",
      "summary": "改进歌词文件保存与失败重试，歌词处理失败时保留已下载的音频，并保留任务原有下载目录和设置。"
    },
    {
      "id": "account",
      "category": "fixes",
      "summary": "修复切换账号或退出后旧请求及缓存影响收藏、推荐和云盘数据的问题，改善离线退出与账号切换；切换流媒体服务器或账号时隔离列表与缓存。"
    },
    {
      "id": "lastfm",
      "category": "fixes",
      "summary": "Last.fm 听歌记录按实际播放时长计算，不计入暂停和缓冲时间；减少重复上报，并避免旧账号的请求影响新授权。"
    },
    {
      "id": "navigation",
      "category": "fixes",
      "summary": "修复导航被限制时等待不结束、云盘搜索保留旧结果、拖拽排序在切页或多指操作后残留，以及永久缓存被提前判定过期的问题。"
    },
    {
      "id": "security",
      "category": "fixes",
      "summary": "加强账号敏感信息在诊断输出和系统备份中的保护，并过滤应用内更新说明中的不安全内容。"
    },
    {
      "id": "android",
      "category": "android",
      "summary": "本版本适用于 Android 10 及以上，提供 arm64-v8a、armeabi-v7a、x86_64 和 x86 架构 APK。"
    },
    {
      "id": "discover",
      "category": "known_issues",
      "summary": "发现音乐的歌单广场收到空响应时，仍可能缺少明确的空态提示。"
    },
    {
      "id": "beta",
      "category": "notes",
      "summary": "这是 Beta 测试版本，可能仍存在未发现的问题。"
    },
    {
      "id": "upgrade",
      "category": "notes",
      "summary": "本测试版与稳定版使用相同包名，安装时可能升级已有应用。请先备份重要数据；不保证可以直接降级。"
    }
  ],

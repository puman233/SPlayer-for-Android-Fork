{
  "previous_tag": "v3.0.16-beta.7",
  "changes": [
    {
      "id": "queue",
      "category": "highlights",
      "summary": "修复随机与心动模式反复切换后的切歌错序，让后台队列、通知栏操作和实际播放保持一致。"
    },
    {
      "id": "lyrics",
      "category": "fixes",
      "summary": "歌词按实际播放曲目更新，清除旧请求影响；TTML失败或超时后继续使用可用歌词。"
    },
    {
      "id": "recovery",
      "category": "fixes",
      "summary": "改善弱网播放恢复和快速切歌的错误处理，限制重试预算，暂停或切源时取消旧恢复任务。"
    },
    {
      "id": "webdav",
      "category": "fixes",
      "summary": "修复WebDAV更换服务器凭据后仍显示旧身份曲目和标签的问题。"
    },
    {
      "id": "security",
      "category": "fixes",
      "summary": "增加应用内特殊代理路径的导航拦截，按框架官方方案缓解已知安全问题。"
    },
    {
      "id": "service",
      "category": "android",
      "summary": "修复首次播放失败或远程暂停时，播放服务可能未及时进入前台而崩溃的问题。"
    },
    {
      "id": "website",
      "category": "features",
      "summary": "完善项目网站的版本下载、更新说明展示和手机访问布局。"
    },
    {
      "id": "device",
      "category": "known_issues",
      "summary": "平板批量回归仍有一项间歇前置异常，独立及组合复验通过但原因未关闭；部分上游音源可能不可用。"
    },
    {
      "id": "risks",
      "category": "known_issues",
      "summary": "剩余依赖公告适用性仍需确认；导航拦截属于缓解，后续仍需升级框架修复版本。"
    }
  ],
